# =============================================================================
# Jarvis Financial Framework (JFF) v2.0 — non-secret configuration
# Aligned to docs/00-ARCHITECTURE-REVIEW-AND-DECISIONS.md (JFF-ADR-000).
#
# `./jarvis init` copies this file to .env and fills in machine-specific
# values. This file holds NO secrets. Secrets are Docker secrets in
# ./.secrets/ (directory 0700, files 0444), written by `./jarvis init`:
#
#   .secrets/vault_to_llm_token      vault-api -> llm-proxy token (generated)
#   .secrets/vault_to_gateway_token  vault-api -> egress-gateway token (generated);
#                                    the gateway never calls the vault
#   .secrets/gatekeeper_hmac_secret  approval binding key (generated)
#   .secrets/anthropic_api_key       optional; empty file if unused
#   .secrets/gemini_api_key          optional; empty file if unused
#   .secrets/push_credentials        ntfy access token or Pushover token+user key
#   .secrets/pii_blocklist           LeakVerifier terms (names, address, employer), one per line
#   .secrets/n8n_encryption_key      only for the optional `automation` profile
#
# There is no master key file. The database key is wrapped by your passphrase
# (Argon2id) and stored in vault.keyfile.json inside the vault volume
# (ADR-02). `./jarvis doctor` refuses to start with missing or placeholder
# secrets (ADR-09).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Runtime profile — exactly one
#    mac          macOS Apple Silicon: OrbStack/Docker Desktop + native Ollama
#    windows-gpu  Windows 11 WSL2 + NVIDIA GPU, Ollama in a container
#    cpu          Windows / Linux / Intel Mac, Ollama in a container on CPU
#    lite         Chromebook / low-RAM: no LLM, rules-only categorisation
#    lite-llm     Chromebook / low-RAM with a small local model on CPU
# -----------------------------------------------------------------------------
JARVIS_PROFILE=mac

# -----------------------------------------------------------------------------
# 2. Statements inbox (mounted READ-ONLY into vault-api and parser)
#    Must be an ABSOLUTE path: Docker Compose does not expand `~`.
#    Default is a non-synced app directory (ADR-09). Do not use a folder that
#    iCloud Drive, OneDrive, Dropbox or Google Drive syncs; `./jarvis doctor`
#    fails closed if you do.
#      macOS:            /Users/<you>/Library/Application Support/Jarvis/inbox
#      Linux / Crostini: /home/<you>/.local/share/jarvis/inbox
#      WSL2:             /home/<you>/.local/share/jarvis/inbox
#                        (Explorer: \\wsl$\<distro>\home\<you>\.local\share\jarvis\inbox)
#    `~/Desktop/Financials` is still supported as an explicit override.
# -----------------------------------------------------------------------------
FINANCIALS_HOST_DIR=/Users/CHANGE_ME/Library/Application Support/Jarvis/inbox

# retain  (default) original files stay in the inbox; mount is read-only
# consume delete a file after it is imported and reconciled (adds a second,
#         write-capable mount used only for that delete)
INBOX_MODE=retain

# Encrypted backups (ADR-08). Absolute path; ideally an external disk.
JARVIS_BACKUP_HOST_DIR=/Users/CHANGE_ME/JarvisBackups

# -----------------------------------------------------------------------------
# 3. Vault lock and key derivation (ADR-02)
# -----------------------------------------------------------------------------
# Auto-lock after this many idle minutes (DEK dropped from memory).
JARVIS_IDLE_LOCK_MINUTES=15

# Argon2id parameters for the passphrase KEK. Values are recorded in
# vault.keyfile.json at init; changing them here only affects the next
# re-wrap (passphrase change). Defaults: m=256 MiB, t=3, p=1.
# lite / lite-llm: set JARVIS_ARGON2_MEMORY_KIB=65536 (64 MiB).
JARVIS_ARGON2_MEMORY_KIB=262144
JARVIS_ARGON2_TIME_COST=3
JARVIS_ARGON2_PARALLELISM=1

# -----------------------------------------------------------------------------
# 4. Container resource caps (defaults are the ADR-03/ADR-04 budgets rounded
#    up). Steady-state budget of all JFF containers excluding Ollama, a target
#    until measured: edge 30 + vault-api 350 + parser 200 + llm-proxy 40 +
#    egress-gateway 90 = ~710 MB. vault-api is capped at 640M for the
#    transient Argon2id allocation during unlock (steady ~350 MB); parser is
#    capped at 384M for OCR peaks (steady ~200 MB).
# -----------------------------------------------------------------------------
VAULT_CPU_LIMIT=1.5
VAULT_MEM_LIMIT=640M
PARSER_CPU_LIMIT=1.0
PARSER_MEM_LIMIT=384M
EDGE_MEM_LIMIT=64M
LLM_PROXY_MEM_LIMIT=48M
EGRESS_MEM_LIMIT=96M
# Container Ollama only (windows-gpu, cpu, lite-llm). lite-llm: 2.0 / 3G.
OLLAMA_CPU_LIMIT=2.0
OLLAMA_MEM_LIMIT=4G

# -----------------------------------------------------------------------------
# 5. Local LLM (ADR-10)
#    vault-api always talks to http://llm-proxy:11434 (fixed in compose).
#    Defaults by profile (ADR-10):
#      mac (16 GB)     gemma4:e4b-it-qat      (upgrade: gemma4:12b-it-qat)
#      cpu/windows-gpu gemma4:e4b-it-qat
#      lite-llm        qwen3.5:2b-q4_K_M
#      lite            none; the wrapper sets JARVIS_LLM_ENABLED=false.
#    Avoid *-nvfp4 tags on Apple Silicon (NVIDIA FP4 format).
#    OLLAMA_MODEL_ID is the 12-hex ID from `ollama list`; `./jarvis doctor`
#    fails if the installed model's ID differs (model pinning).
#    llm-proxy forces think=false, temperature=0 and caps num_ctx and
#    keep_alive at the values below, whatever the caller sends.
# -----------------------------------------------------------------------------
OLLAMA_MODEL=gemma4:e4b-it-qat
OLLAMA_MODEL_ID=ee6656371218
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=15m
JARVIS_LLM_ENABLED=true

# -----------------------------------------------------------------------------
# 6. Pay periods (ADR-05)
#    Pay periods are derived from detected paycheck deposits. The anchor is a
#    FALLBACK used only until enough paychecks are detected. YYYY-MM-DD.
# -----------------------------------------------------------------------------
BIWEEKLY_ANCHOR_DATE=

# -----------------------------------------------------------------------------
# 7. Egress gateway (ADR-01, ADR-03)
# -----------------------------------------------------------------------------
# manual (default): every outbound request needs phone passkey approval.
# autonomous_verified: can only be enabled from the desktop with passphrase
# re-entry; it is an audit event. The phone page cannot change it.
GATEKEEPER_MODE=manual

# Precision coarsening of outbound numbers (not "k-anonymity"):
#   bucket_25_usd | bucket_100_usd | ratio_index_10k
GATEKEEPER_COARSEN_MODE=bucket_100_usd

# Cloud provider used after approval: none | anthropic | gemini
CLOUD_PROVIDER=none

# Your Tailscale login. The approval page rejects any request whose
# Tailscale-User-Login header differs. Required.
JARVIS_OWNER_TAILNET_LOGIN=you@example.com

# -----------------------------------------------------------------------------
# 8. Push notifications (content-free: count + audit chain head only)
#    ntfy (self-hosted recommended) | pushover
#    Credentials go in .secrets/push_credentials, not here.
# -----------------------------------------------------------------------------
PUSH_PROVIDER=ntfy
NTFY_URL=https://ntfy.example.ts.net
NTFY_TOPIC=jarvis-CHANGE_ME_random_suffix

# -----------------------------------------------------------------------------
# 9. Misc
# -----------------------------------------------------------------------------
TZ=America/New_York
JARVIS_WATCH_INTERVAL_SECONDS=3
JARVIS_PARSE_MAX_FILE_MB=25
